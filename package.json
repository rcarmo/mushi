{
  "name": "mushi-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun run build && bun test",
    "build": "bun scripts/bundle.ts",
    "android:prepare": "python3 scripts/prepare-android.py",
    "android:build": "bun scripts/build-apk.ts",
    "runtime:build": "bun scripts/build-runtime.ts",
    "runtime:fetch": "bun scripts/build-runtime.ts --fetch-only",
    "runtime:smoke": "bun run build && bun scripts/smoke-runtime.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "diff": "8.0.4",
    "highlight.js": "11.11.1",
    "htmlparser2": "10.0.0",
    "ignore": "7.0.5",
    "markdown-it": "14.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
